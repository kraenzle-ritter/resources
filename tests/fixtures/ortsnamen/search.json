{"count":6,"next":null,"previous":null,"results":[{"id":7073540,"url":"https://ortsnamen.ch/de/api/toponyms/7073540","permalink":"https://ortsnamen.ch/de/record/7073540","name":"Wiedikon","description":["Stadtquartier zwischen Sihl und Uetliberg. Die ehemals eigenständige Gemeinde wurde 1893 in die Stadt Zürich inkorporiert, der historische Dorfkern zwischen Birmensdorferstrasse und Schlossgasse um 1930 überbaut. Latènezeitl. und frühma. Gräber im Gebiet (vgl. e-HLS). In der Urkunde von 889 mit dem Erstbeleg schenkt Perehtelo dem Fraumünsterkloster Zürich seinen Besitz in Wiedikon. Im 16. Jh. bildete Wiedikon eine eigene Obervogtei."],"localisation":"POINT (8.509593170773655 47.364220245490884)","cantons":["ZH"],"districts":["Zürich"],"municipalities":["Zürich"],"types":["[Teil von] Siedlung","Ortsteil"],"historical_records":[{"biblio":"ZHUB I 66 (Nr. 153) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 1","text":"in loco nuncupato Wiedinchova","year":889,"provider":["Zürcher Siedlungsnamenbuch"],"form":"Wiedinchova"},{"biblio":"ZHUB I 269 (Nr. 384) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 1","text":"territorium in Wiedenchoven","year":1218,"provider":["Zürcher Siedlungsnamenbuch"],"form":"Wiedenchoven"},{"biblio":"ZHUB I 329f. (Nr. 449) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 1","text":"Waltherum et Uͦlricum dictos leones de Wiedinkon [...] Hugo de Wiedinkon","year":1229,"provider":["Zürcher Siedlungsnamenbuch"],"form":"Wiedinkon"},{"biblio":"ZHUB IV 139 (Nr. 1433) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 4","text":"possessiones meas sitas in Wiedinkon","year":1270,"provider":["Zürcher Siedlungsnamenbuch"],"form":"Wiedinkon"},{"biblio":"ZHUB IV 145 (Nr. 1439) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 4","text":"item dotem in Wiedinkon","year":1270,"provider":["Zürcher Siedlungsnamenbuch"],"form":"Wiedinkon"},{"biblio":"ZHUB IV 183 (Nr. 1474) Urkundenbuch der Stadt und Landschaft Zürich, Bd. 4","text":"Burcardus et Heinricus fra