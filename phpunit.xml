<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    backupGlobals="false"
    backupStaticProperties="false"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    failOnDeprecation="true"
    failOnNotice="true"
    failOnWarning="true">
  <testsuites>
    <testsuite name="Test Suite">
      <directory suffix="Test.php">tests</directory>
    </testsuite>
  </testsuites>
  <groups>
    <!--
      Tests that talk to the real provider APIs. Excluded by default so the
      suite is deterministic and offline. CI runs them on a schedule via the
      live-api group to notice upstream drift.
    -->
    <exclude>
      <group>live-api</group>
    </exclude>
  </groups>
  <php>
    <env name="DB_CONNECTION" value="testing"/>
  </php>
  <!--
    Only src/ is listed and indirect deprecations are ignored, so
    failOnDeprecation fails the suite on deprecations raised by this package
    rather than by the framework or its dependencies.
  -->
  <source
      restrictNotices="true"
      restrictWarnings="true"
      ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">src/</directory>
    </include>
  </source>
</phpunit>
